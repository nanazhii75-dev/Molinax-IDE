<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Putar dari URL"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/mpv_url_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tempel URL video di sini"
        android:inputType="textUri"
        android:maxLines="1" />

    <Button
        android:id="@+id/mpv_play_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Putar"
        android:backgroundTint="#00C853"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/mpv_browse_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Buka File Browser"
        android:backgroundTint="@color/grey_500"
        android:textColor="@color/white" />

    <ProgressBar
        android:id="@+id/mpv_loading_indicator"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>
